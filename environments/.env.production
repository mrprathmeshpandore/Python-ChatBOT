# Production Environment Variables
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL

# Database (PostgreSQL + pgvector)
# Replace user, password, host, and db with your production credentials
DATABASE_URL=postgresql+asyncpg://postgres:super_secret_password@db:5432/chatbot_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super_secret_password
POSTGRES_DB=chatbot_prod

# Redis
REDIS_URL=redis://redis:6379/0

# App Settings
PROJECT_NAME="Chatbot AI - Production"
VERSION="1.0.0"

# Security
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=replace_me_with_a_secure_generated_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
OPENAI_API_KEY=sk-your-production-openai-api-key
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
